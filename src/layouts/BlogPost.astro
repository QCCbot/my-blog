---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogData = CollectionEntry<'blog'>['data'];
type Heading = {
	depth: number;
	slug: string;
	text: string;
};
type RelatedPost = Pick<BlogData, 'title' | 'description'> & { slug: string };
type Props = BlogData & {
	headings?: Heading[];
	relatedPosts?: RelatedPost[];
	slug?: string;
	body?: string;
	hideMeta?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	relatedPosts = [],
	body = '',
	hideMeta = false,
} = Astro.props;

const articleUrl = new URL(Astro.url.pathname, 'https://blog.qccbot.com').toString();
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(articleUrl);
const articleImageUrl = heroImage ? new URL(heroImage.src, Astro.url).toString() : undefined;
const articleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const keySections = headings.filter((heading) => heading.depth === 2).slice(0, 6);
const plainBody = body
	.replace(/```[\s\S]*?```/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/[#>*_`[\]()!-]/g, ' ')
	.trim();
const cjkCount = (plainBody.match(/[\u3400-\u9fff]/g) ?? []).length;
const wordCount = plainBody.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(3, Math.ceil((wordCount + cjkCount / 2) / 220));

const lowerTitle = title.toLowerCase();
const category = lowerTitle.includes('autojs')
	? 'AutoJS scripting'
	: lowerTitle.includes('agent')
		? 'AI agents'
		: lowerTitle.includes('tiktok') || lowerTitle.includes('short video')
			? 'Social operations'
			: lowerTitle.includes('shop') || lowerTitle.includes('cross-border')
				? 'Cross-border workflows'
				: 'Cloud phone automation';

const extractFaqItems = (markdown: string) => {
	const faqStart = markdown.search(/^##\s+(FAQ|Frequently asked questions)\s*$/im);
	if (faqStart === -1) return [];

	const faqBody = markdown.slice(faqStart).replace(/^##\s+.*$/im, '');
	const nextH2 = faqBody.search(/\n##\s+/);
	const section = nextH2 === -1 ? faqBody : faqBody.slice(0, nextH2);
	const matches = [...section.matchAll(/^###\s+(.+?)\s*\n([\s\S]*?)(?=\n###\s+|\n##\s+|$)/gm)];

	return matches
		.map((match) => ({
			question: match[1].trim(),
			answer: match[2]
				.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
				.replace(/[*_`>#-]/g, '')
				.replace(/\s+/g, ' ')
				.trim(),
		}))
		.filter((item) => item.question && item.answer)
		.slice(0, 6);
};

const faqItems = extractFaqItems(body);

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		mainEntityOfPage: articleUrl,
		url: articleUrl,
		image: articleImageUrl,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		articleSection: category,
		inLanguage: 'en-US',
		author: {
			'@type': 'Organization',
			name: 'QCCBot Editorial',
			url: 'https://www.qccbot.com/',
		},
		publisher: {
			'@type': 'Organization',
			name: 'QCCBot',
			logo: {
				'@type': 'ImageObject',
				url: new URL('/qccbot-icon.png', Astro.site).toString(),
			},
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'QCCBot Blog',
				item: new URL('/blog/', Astro.site).toString(),
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: title,
				item: articleUrl,
			},
		],
	},
];

if (faqItems.length > 0) {
	structuredData.push({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	});
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<style>
			:root {
				--qccbot-navy: #0f2638;
				--qccbot-blue: #2337ff;
				--qccbot-cyan: #0ca6c8;
				--qccbot-line: #dfe8ef;
				--qccbot-soft: #f5f9fb;
				--qccbot-mint: #e8f7f3;
			}
			.post-page *,
			.post-page *::before,
			.post-page *::after {
				box-sizing: border-box;
			}
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}
			.post-page {
				background: #fff;
				overflow-x: hidden;
			}
			.post-hero {
				padding: 4.5rem 1.25rem 2.25rem;
				border-bottom: 1px solid var(--qccbot-line);
				background:
					linear-gradient(0deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.92)),
					linear-gradient(90deg, #eff9fb, #f8fbff);
			}
			.hero-inner {
				max-width: 1120px;
				margin: 0 auto;
			}
			.category-tag {
				display: inline-flex;
				align-items: center;
				margin-bottom: 1.1rem;
				padding: 0.35rem 0.65rem;
				border: 1px solid rgba(12, 166, 200, 0.35);
				border-radius: 999px;
				background: #fff;
				color: var(--qccbot-cyan);
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0;
				text-transform: uppercase;
			}
			.post-hero h1 {
				max-width: 900px;
				margin: 0;
				color: var(--qccbot-navy);
				font-size: clamp(2.45rem, 5vw, 5.25rem);
				line-height: 0.98;
				letter-spacing: 0;
				overflow-wrap: anywhere;
			}
			.subtitle {
				max-width: 760px;
				margin: 1.25rem 0 0;
				color: #42566c;
				font-size: 1.18rem;
				line-height: 1.65;
				overflow-wrap: anywhere;
			}
			.hero-footer {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: 1.8rem;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				color: #53677a;
				font-size: 0.95rem;
			}
			.post-meta span:not(:last-child)::after {
				content: "/";
				margin-left: 1rem;
				color: #9aaabd;
			}
			.share-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.share-row a,
			.share-row button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 2.25rem;
				padding: 0 0.75rem;
				border: 1px solid var(--qccbot-line);
				border-radius: 999px;
				background: #fff;
				color: var(--qccbot-navy);
				font: inherit;
				font-size: 0.88rem;
				font-weight: 700;
				text-decoration: none;
				cursor: pointer;
			}
			.share-row a:hover,
			.share-row button:hover {
				border-color: var(--qccbot-cyan);
				color: var(--qccbot-cyan);
			}
			.hero-media {
				max-width: 1120px;
				margin: 2rem auto 0;
			}
			.hero-media img {
				display: block;
				width: 100%;
				border-radius: 8px;
				box-shadow: 0 24px 60px rgba(15, 38, 56, 0.16);
			}
			.article-shell {
				display: grid;
				grid-template-columns: minmax(170px, 220px) minmax(0, 760px) minmax(210px, 270px);
				gap: 2rem;
				max-width: 1360px;
				margin: 0 auto;
				padding: 3rem 1.25rem 4rem;
			}
			.article-shell.no-toc {
				grid-template-columns: minmax(0, 800px) minmax(210px, 270px);
				justify-content: center;
			}
			.toc,
			.right-rail {
				position: sticky;
				top: 5rem;
				align-self: start;
			}
			.sidebar-card,
			.key-card,
			.reader-cta,
			.faq-block,
			.related-posts,
			.author-card {
				border: 1px solid var(--qccbot-line);
				border-radius: 8px;
				background: #fff;
			}
			.sidebar-card {
				padding: 1rem;
			}
			.sidebar-title {
				margin: 0 0 0.75rem;
				color: var(--qccbot-navy);
				font-size: 0.82rem;
				font-weight: 700;
				text-transform: uppercase;
			}
			.toc nav {
				display: grid;
				gap: 0.45rem;
			}
			.toc a {
				color: #52687c;
				font-size: 0.92rem;
				line-height: 1.35;
				text-decoration: none;
			}
			.toc a.depth-3 {
				padding-left: 0.85rem;
				font-size: 0.84rem;
			}
			.toc a:hover {
				color: var(--qccbot-blue);
			}
			.article-main {
				min-width: 0;
			}
			.key-card {
				margin-bottom: 1.4rem;
				padding: 1.1rem;
				background: var(--qccbot-soft);
			}
			.key-card h2,
			.faq-block h2,
			.related-posts h2,
			.author-card h2 {
				margin: 0 0 0.8rem;
				font-size: 1.25rem;
				line-height: 1.2;
			}
			.key-card ul {
				display: grid;
				gap: 0.55rem;
				margin: 0;
				padding-left: 1.15rem;
			}
			.answer-card {
				margin-bottom: 1.4rem;
				padding: 1.1rem;
				border: 1px solid rgba(12, 166, 200, 0.26);
				border-radius: 8px;
				background: #fbfeff;
			}
			.answer-card h2 {
				margin: 0 0 0.55rem;
				color: var(--qccbot-navy);
				font-size: 1.2rem;
				line-height: 1.25;
			}
			.answer-card p {
				margin: 0;
				color: #40566a;
				font-size: 1rem;
				line-height: 1.65;
			}
			.reader-cta {
				margin: 1.4rem 0 2.25rem;
				padding: 1.15rem;
				background: var(--qccbot-mint);
			}
			.reader-cta p {
				margin: 0.35rem 0 0.9rem;
				color: #385060;
				font-size: 0.98rem;
				line-height: 1.55;
			}
			.cta-link {
				display: inline-flex;
				align-items: center;
				min-height: 2.35rem;
				padding: 0 0.9rem;
				border-radius: 6px;
				background: var(--qccbot-navy);
				color: #fff;
				font-size: 0.92rem;
				font-weight: 700;
				text-decoration: none;
			}
			.article-body {
				color: #26394d;
				font-size: 1.05rem;
				line-height: 1.82;
				overflow-wrap: anywhere;
			}
			.article-body :global(p) {
				margin: 0 0 1.2rem;
			}
			.article-body :global(h2) {
				margin: 3.2rem 0 1rem;
				padding-top: 0.25rem;
				color: var(--qccbot-navy);
				font-size: clamp(2rem, 4vw, 3rem);
				line-height: 1.08;
				letter-spacing: 0;
			}
			.article-body :global(h3) {
				margin: 2.1rem 0 0.75rem;
				color: #152f43;
				font-size: 1.55rem;
				line-height: 1.2;
			}
			.article-body :global(ul),
			.article-body :global(ol) {
				display: grid;
				gap: 0.55rem;
				margin: 0 0 1.4rem;
				padding-left: 1.4rem;
			}
			.article-body :global(li) {
				padding-left: 0.2rem;
			}
			.article-body :global(blockquote) {
				margin: 2rem 0;
				padding: 1rem 1.2rem;
				border-left: 4px solid var(--qccbot-cyan);
				border-radius: 0 8px 8px 0;
				background: var(--qccbot-soft);
				font-size: 1.08rem;
			}
			.article-body :global(p:has(a[href*="qccbot.com"])) {
				margin: 2rem 0;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(35, 55, 255, 0.18);
				border-radius: 8px;
				background: #f7f8ff;
			}
			.faq-block,
			.related-posts,
			.author-card {
				margin-top: 2.5rem;
				padding: 1.2rem;
			}
			.faq-list {
				display: grid;
				gap: 0.8rem;
			}
			.faq-item {
				padding: 0.95rem;
				border: 1px solid var(--qccbot-line);
				border-radius: 8px;
				background: var(--qccbot-soft);
			}
			.faq-item h3 {
				margin: 0 0 0.35rem;
				font-size: 1rem;
			}
			.faq-item p {
				margin: 0;
				color: #40566a;
				font-size: 0.95rem;
				line-height: 1.55;
			}
			.related-grid {
				display: grid;
				gap: 0.85rem;
			}
			.related-card {
				display: block;
				padding: 1rem;
				border: 1px solid var(--qccbot-line);
				border-radius: 8px;
				color: inherit;
				text-decoration: none;
			}
			.related-card:hover {
				border-color: var(--qccbot-cyan);
			}
			.related-card h3 {
				margin: 0 0 0.35rem;
				font-size: 1.05rem;
			}
			.related-card p {
				margin: 0;
				color: #52687c;
				font-size: 0.92rem;
				line-height: 1.5;
			}
			.author-card {
				background: var(--qccbot-soft);
			}
			.author-card p {
				margin: 0;
				color: #40566a;
				font-size: 0.95rem;
				line-height: 1.6;
			}
			.rail-cta {
				padding: 1rem;
				background: var(--qccbot-navy);
				color: #fff;
			}
			.rail-cta h2 {
				margin: 0 0 0.45rem;
				color: #fff;
				font-size: 1.05rem;
				line-height: 1.25;
			}
			.rail-cta p {
				margin: 0 0 0.9rem;
				color: #d6e7ef;
				font-size: 0.9rem;
				line-height: 1.5;
			}
			.rail-cta a {
				display: inline-flex;
				align-items: center;
				min-height: 2.25rem;
				padding: 0 0.75rem;
				border-radius: 6px;
				background: #fff;
				color: var(--qccbot-navy);
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
			}
			.rail-share {
				margin-top: 1rem;
			}
			.social-angle {
				margin-top: 1rem;
				padding: 1rem;
			}
			.social-angle p {
				margin: 0;
				color: #40566a;
				font-size: 0.9rem;
				line-height: 1.55;
			}
			@media (max-width: 1180px) {
				.article-shell {
					grid-template-columns: minmax(170px, 220px) minmax(0, 760px);
				}
				.right-rail {
					display: none;
				}
			}
			@media (max-width: 900px) {
				.post-hero {
					padding-top: 2.75rem;
				}
				.article-shell {
					display: block;
					padding-top: 2rem;
				}
				.toc {
					position: static;
					margin-bottom: 1.25rem;
				}
				.toc nav {
					grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				}
				.post-hero h1 {
					font-size: clamp(2.15rem, 12vw, 3.2rem);
				}
				.hero-footer {
					align-items: flex-start;
					flex-direction: column;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-page">
			<article>
				<header class="post-hero">
					<div class="hero-inner">
						<span class="category-tag">{category}</span>
						<h1>{title}</h1>
						<p class="subtitle">{description}</p>
						<div class="hero-footer">
							{
								!hideMeta && (
									<div class="post-meta">
										<span>QCCBot Editorial</span>
										<span>
											<FormattedDate date={pubDate} />
										</span>
										<span>{readingTime} min read</span>
										{updatedDate && (
											<span>
												Updated <FormattedDate date={updatedDate} />
											</span>
										)}
									</div>
								)
							}
							<div class="share-row" aria-label="Share this article">
								<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank"
									>LinkedIn</a
								>
								<a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank"
									>X</a
								>
								<a href={`mailto:?subject=${shareText}&body=${shareUrl}`}>Email</a>
							</div>
						</div>
					</div>
					{
						heroImage && (
							<figure class="hero-media">
								<Image width={1280} height={640} src={heroImage} alt="" />
							</figure>
						)
					}
				</header>

				<div class={`article-shell ${hideMeta ? 'no-toc' : ''}`}>
					{
						!hideMeta && (
							<aside class="toc" aria-label="Article table of contents">
								<div class="sidebar-card">
									<p class="sidebar-title">In This Article</p>
									<nav>
										{articleHeadings.length > 0 ? (
											articleHeadings.map((heading) => (
												<a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>
													{heading.text}
												</a>
											))
										) : (
											<a href="#key-sections">Key sections</a>
										)}
									</nav>
								</div>
							</aside>
						)
					}

					<div class="article-main">
						{
							keySections.length > 0 && (
								<section class="key-card" id="key-sections">
									<h2>What this article covers</h2>
									<ul>{keySections.map((heading) => <li>{heading.text}</li>)}</ul>
								</section>
							)
						}

						<div class="article-body">
							<slot />
						</div>

						{relatedPosts.length > 0 && (
							<section class="related-posts">
								<h2>Recommended reading</h2>
								<div class="related-grid">
									{relatedPosts.map((post) => (
										<a class="related-card" href={`/blog/${post.slug}/`}>
											<h3>{post.title}</h3>
											<p>{post.description}</p>
										</a>
									))}
								</div>
							</section>
						)}

						<section class="author-card">
							<h2>About QCCBot</h2>
							<p>
								QCCBot is an AI cloud phone platform for teams that need Android cloud phones, AutoJS
								automation, script generation, task logs, and controlled exception recovery.
							</p>
						</section>
					</div>

					<aside class="right-rail" aria-label="Article actions">
						<div class="rail-cta">
							<h2>Automate mobile app work</h2>
							<p>Generate scripts, run them on cloud phones, and recover from common failures with AI.</p>
							<a href="https://www.qccbot.com/">Visit QCCBot</a>
						</div>
						<div class="sidebar-card rail-share">
							<p class="sidebar-title">Share</p>
							<div class="share-row">
								<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank"
									>LinkedIn</a
								>
								<a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank"
									>X</a
								>
							</div>
						</div>
					</aside>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
