---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pillars = [
	{
		name: 'AI cloud phone automation',
		description: 'Start here if you are trying to automate Android app workflows with AI.',
		match: ['ai-cloud-phone', 'ai-mobile', 'android-cloud', 'automation-guide', 'best-practices'],
	},
	{
		name: 'AutoJS scripts and AI debugging',
		description: 'Guides for generating, testing, debugging, and safely recovering AutoJS scripts.',
		match: ['autojs', 'script', 'xeasy', 'debug', 'recovery', 'failed'],
	},
	{
		name: 'Social commerce and short video operations',
		description: 'Mobile workflows for TikTok, short video, social media account checks, and content QA.',
		match: ['tiktok', 'short-video', 'social', 'commerce', 'content'],
	},
	{
		name: 'Account safety, logs, and operations governance',
		description: 'How teams manage many cloud phones with visibility, review queues, and safer AI takeover.',
		match: ['security', 'logs', 'observability', 'account', 'guardian', 'groups'],
	},
];

const pillarPosts = pillars.map((pillar) => ({
	...pillar,
	posts: posts
		.filter((post) => pillar.match.some((term) => post.id.includes(term)))
		.slice(0, 5),
}));

const searchQuestions = [
	'How do I automate Android app tasks without physical phones?',
	'Can AI generate and debug AutoJS scripts?',
	'What happens when a cloud phone script fails?',
	'How do teams check many TikTok or social commerce accounts?',
	'Why do browser AI agents stop when work moves into mobile apps?',
	'How can operations teams see logs, failures, and recovery attempts?',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
			}
			.blog-hero {
				padding: 4rem 1.25rem 2.5rem;
				border-bottom: 1px solid #dfe8ef;
				background:
					linear-gradient(0deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.92)),
					linear-gradient(90deg, #eff9fb, #f8fbff);
			}
			.inner {
				max-width: 1180px;
				margin: 0 auto;
			}
			.eyebrow {
				display: inline-flex;
				margin: 0 0 1rem;
				padding: 0.35rem 0.65rem;
				border: 1px solid rgba(12, 166, 200, 0.35);
				border-radius: 999px;
				background: #fff;
				color: #0c9fbd;
				font-size: 0.82rem;
				font-weight: 700;
				text-transform: uppercase;
			}
			h1 {
				max-width: 920px;
				margin: 0;
				color: #0f2638;
				font-size: clamp(2.6rem, 6vw, 5.4rem);
				line-height: 0.98;
				letter-spacing: 0;
			}
			.hero-copy {
				max-width: 780px;
				margin: 1.2rem 0 0;
				color: #42566c;
				font-size: 1.12rem;
				line-height: 1.65;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}
			.hero-actions a {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 2.6rem;
				padding: 0 1rem;
				border: 1px solid #2337ff;
				border-radius: 8px;
				background: #2337ff;
				color: #fff;
				font-weight: 800;
				text-decoration: none;
			}
			.hero-actions a.secondary {
				background: #fff;
				color: #2337ff;
			}
			.question-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.75rem;
				margin-top: 2rem;
			}
			.question-grid a {
				display: block;
				padding: 0.95rem;
				border: 1px solid #dfe8ef;
				border-radius: 8px;
				background: #fff;
				color: #183246;
				font-weight: 700;
				line-height: 1.35;
				text-decoration: none;
			}
			.question-grid a:hover {
				border-color: #0ca6c8;
				color: #2337ff;
			}
			.blog-body {
				padding: 3rem 1.25rem 4rem;
			}
			.featured {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
				gap: 1.5rem;
				align-items: stretch;
				margin-bottom: 3rem;
			}
			.featured-card,
			.post-card,
			.pillar-card {
				border: 1px solid #dfe8ef;
				border-radius: 8px;
				background: #fff;
				overflow: hidden;
			}
			.featured-card a,
			.post-card a {
				display: block;
				color: inherit;
				text-decoration: none;
			}
			.featured-card img,
			.post-card img {
				display: block;
				width: 100%;
				height: auto;
			}
			.card-copy {
				padding: 1.1rem;
			}
			.card-copy h2,
			.card-copy h3 {
				margin: 0 0 0.65rem;
				color: #0f2638;
				line-height: 1.08;
			}
			.card-copy p {
				margin: 0;
				color: #52687c;
				line-height: 1.55;
			}
			.date {
				display: block;
				margin-top: 0.85rem;
				color: #65798d;
				font-size: 0.92rem;
			}
			.pillar-section {
				margin-top: 2.75rem;
			}
			.section-heading {
				margin: 0 0 1rem;
				color: #0f2638;
				font-size: clamp(1.8rem, 3vw, 2.6rem);
				line-height: 1.05;
			}
			.pillar-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.pillar-card {
				padding: 1.1rem;
			}
			.pillar-card h3 {
				margin: 0 0 0.45rem;
				color: #0f2638;
				font-size: 1.2rem;
			}
			.pillar-card p {
				margin: 0 0 1rem;
				color: #52687c;
				line-height: 1.55;
			}
			.pillar-card ul {
				display: grid;
				gap: 0.6rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.pillar-card a {
				color: #183246;
				font-weight: 700;
				line-height: 1.35;
				text-decoration: none;
			}
			.pillar-card a:hover {
				color: #2337ff;
			}
			.recent-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.ai-note {
				margin-top: 3rem;
				padding: 1.25rem;
				border: 1px solid rgba(12, 166, 200, 0.3);
				border-radius: 8px;
				background: #f5fbfc;
			}
			.ai-note h2 {
				margin: 0 0 0.55rem;
				color: #0f2638;
				font-size: 1.35rem;
			}
			.ai-note p {
				margin: 0;
				color: #40566a;
				line-height: 1.65;
			}
			.all-posts {
				display: grid;
				gap: 0.65rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.all-posts a {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 1rem;
				align-items: baseline;
				padding: 0.9rem 0;
				border-bottom: 1px solid #dfe8ef;
				color: #183246;
				text-decoration: none;
			}
			.all-posts a:hover strong {
				color: #2337ff;
			}
			.all-posts strong {
				font-size: 1rem;
				line-height: 1.35;
			}
			.all-posts span {
				color: #65798d;
				font-size: 0.9rem;
				white-space: nowrap;
			}
			@media (max-width: 900px) {
				.question-grid,
				.featured,
				.pillar-grid,
				.recent-grid {
					grid-template-columns: 1fr;
				}
				.all-posts a {
					grid-template-columns: 1fr;
					gap: 0.35rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-hero">
				<div class="inner">
					<p class="eyebrow">QCCBot Blog</p>
					<h1>Practical guides for AI cloud phone operations</h1>
					<p class="hero-copy">
						Learn how teams use Android cloud phones, AI-generated AutoJS scripts, task logs,
						and controlled exception recovery to manage real mobile app workflows.
					</p>
					<div class="hero-actions">
						<a href="#all-articles">View all articles</a>
						<a class="secondary" href="#content-pillars">Browse by topic</a>
					</div>
					<div class="question-grid" aria-label="Common search questions">
						{searchQuestions.map((question) => <a href="#content-pillars">{question}</a>)}
					</div>
				</div>
			</section>

			<section class="blog-body">
				<div class="inner">
					<div class="featured">
						<article class="featured-card">
							<a href={`/blog/${posts[0].id}/`}>
								{posts[0].data.heroImage && (
									<Image width={960} height={480} src={posts[0].data.heroImage} alt="" />
								)}
								<div class="card-copy">
									<h2>{posts[0].data.title}</h2>
									<p>{posts[0].data.description}</p>
									<span class="date"><FormattedDate date={posts[0].data.pubDate} /></span>
								</div>
							</a>
						</article>
						<div class="pillar-card">
							<h3>Write for the moment someone is stuck</h3>
							<p>
								These articles are written for people who are already stuck: an automation script keeps
								stopping, a browser agent cannot enter a mobile app, too many phone accounts need
								checking, or a failed task needs a safe next step.
							</p>
							<ul>
								<li><a href="/blog/browser-ai-agent-stops-at-mobile-apps/">Why can't my browser AI agent control a mobile app?</a></li>
								<li><a href="/blog/how-to-generate-autojs-script-with-ai/">How do I turn a mobile app task into an AutoJS script?</a></li>
								<li><a href="/blog/ai-takeover-for-failed-autojs-script/">What should happen when an AutoJS script fails?</a></li>
							</ul>
						</div>
					</div>

					<section class="pillar-section" id="content-pillars">
						<h2 class="section-heading">Explore by workflow problem</h2>
						<div class="pillar-grid">
							{pillarPosts.map((pillar) => (
								<article class="pillar-card">
									<h3>{pillar.name}</h3>
									<p>{pillar.description}</p>
									<ul>
										{pillar.posts.map((post) => (
											<li>
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</li>
										))}
									</ul>
								</article>
							))}
						</div>
					</section>

					<section class="pillar-section">
						<h2 class="section-heading">Latest articles</h2>
						<div class="recent-grid">
							{posts.slice(1, 13).map((post) => (
								<article class="post-card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={560} height={280} src={post.data.heroImage} alt="" />
										)}
										<div class="card-copy">
											<h3>{post.data.title}</h3>
											<p>{post.data.description}</p>
											<span class="date"><FormattedDate date={post.data.pubDate} /></span>
										</div>
									</a>
								</article>
							))}
						</div>
					</section>

					<section class="ai-note">
						<h2>Built for people and answer engines</h2>
						<p>
							QCCBot articles use clear questions, practical examples, FAQ blocks, structured article
							data, and machine-readable site files so readers and AI answer engines can understand what
							each guide solves.
						</p>
					</section>

					<section class="pillar-section" id="all-articles">
						<h2 class="section-heading">All articles</h2>
						<ul class="all-posts">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<strong>{post.data.title}</strong>
										<span><FormattedDate date={post.data.pubDate} /></span>
									</a>
								</li>
							))}
						</ul>
					</section>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
