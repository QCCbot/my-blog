---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.qccbot.com/" target="_blank">
				<span class="sr-only">Visit QCCBot website</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 1.2a6.8 6.8 0 1 0 0 13.6A6.8 6.8 0 0 0 8 1.2Zm0 1.25c.78 0 1.52.16 2.18.45-.35.3-.79.56-1.3.76-.28-.5-.58-.9-.88-1.21Zm-1.02.18c.3.32.6.76.88 1.3-.7.15-1.48.15-2.18 0 .28-.54.58-.98.88-1.3Zm-1.9.77c.32.16.68.3 1.08.4-.22.62-.37 1.3-.43 2.02H3.4a5.56 5.56 0 0 1 1.68-2.42ZM3.05 7.07h2.62a10.1 10.1 0 0 0 .22 2.1c-.58.14-1.1.34-1.55.6a5.52 5.52 0 0 1-.29-2.7Zm1.95 3.84c.34-.22.76-.4 1.23-.52.23.6.52 1.1.84 1.48-.75-.13-1.46-.43-2.07-.96Zm2.55 1.26c-.32-.36-.63-.88-.88-1.54.45-.05.91-.05 1.36 0-.25.66-.56 1.18-.88 1.54Zm.62-3.66c-.57-.07-1.14-.05-1.7.06a8.8 8.8 0 0 1-.17-1.5h2.13c-.01.52-.04 1.03-.26 1.44Zm.48-2.7H6.3c.05-.6.18-1.15.36-1.65.75.13 1.58.13 2.33 0 .18.5.31 1.05.36 1.65Zm.82 6.05c.32-.38.6-.88.84-1.48.48.12.9.3 1.24.52-.61.53-1.32.83-2.08.96Zm2.72-1.99a5.8 5.8 0 0 0-1.55-.6c.15-.67.23-1.38.22-2.1h2.63c.1.97-.1 1.9-.3 2.7Zm-1.37-4.06a9.17 9.17 0 0 0-.43-2.02c.4-.1.76-.24 1.09-.4a5.54 5.54 0 0 1 1.67 2.42h-2.33Z"
					></path></svg
				>
			</a>
			<a href="/blog">
				<span class="sr-only">Read QCCBot blog</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M3 1.5h8.5L14 4v10.5H3A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5Zm0 1.25a.25.25 0 0 0-.25.25v10c0 .14.11.25.25.25h9.75V4.5H11a1 1 0 0 1-1-1V2.75H3Zm2 3h6v1.2H5v-1.2Zm0 2.5h6v1.2H5v-1.2Zm0 2.5h4v1.2H5v-1.2Z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
